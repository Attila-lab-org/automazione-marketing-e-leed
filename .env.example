# Supabase (obbligatorie)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login (internal tool — NOT Supabase Auth)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# App URL (demo / email preview links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Places — runtime usa GOOGLE_PLACES_PROVIDER_MODE (non GOOGLE_PLACES_MODE)
GOOGLE_PLACES_PROVIDER_MODE=mock
GOOGLE_PLACES_API_KEY=

# Resend — tenere mock fino a certificazione autorizzata
RESEND_PROVIDER_MODE=mock
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
# Comma-separated exact emails allowed as Campaign TEST actual recipients (server-side)
RESEND_TEST_RECIPIENT_ALLOWLIST=
# I messaggi successivi automatici restano spenti. Attivare solo dopo decisione esplicita.
AUTO_FOLLOWUPS_ENABLED=false

# Production cron worker: Authorization Bearer $CRON_SECRET → /api/cron/jobs
CRON_SECRET=

BROWSER_WORKER_PROVIDER_MODE=mock
AI_PROVIDER_MODE=mock

# Telegram inbound (V1 multi-canale). Disabilitato di default.
# Webhook: POST /api/webhooks/inbound/telegram
# Header live: X-Telegram-Bot-Api-Secret-Token = TELEGRAM_WEBHOOK_SECRET
TELEGRAM_ENABLED=false
TELEGRAM_PROVIDER_MODE=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Owner commercial contact (Restaurant Premium V3 owner CTA)
# /demo/[slug]/interesse?channel=whatsapp|site
# Nessun fallback hardcoded: se mancano → CTA non generati / 503 elegante
OWNER_CONTACT_URL=
OWNER_WHATSAPP=
# Nome o marchio mostrato nella firma delle email (es. Attila Lab)
OWNER_SENDER_NAME=Attila Lab
# Opzionale: se valorizzato (es. 350€) compare in template e messaggio WhatsApp
OWNER_OFFER_PRICE=
# Opzionale: mid-page OwnerBridge (default OFF). 1|true|yes|on
OWNER_SHOW_BRIDGE=
